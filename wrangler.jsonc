{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-identity",
  "main": "worker.js",
  "compatibility_date": "2026-06-11",
  "vars": {
    "DESTINATION_EMAIL": "pasqualecaiazzo.adv@gmail.com"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
